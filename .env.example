# Variables de entorno para Academia Web (local / Docker)
# Copia este archivo a .env y ajusta los valores

# Base de datos PostgreSQL (Docker local)
DATABASE_URL=postgres://postgres:password@localhost:5432/academia

# URL pública del sitio (para enlaces en emails)
PUBLIC_SITE_URL=https://cursos.neuraljira.tech

# Secreto JWT para autenticación
JWT_SECRET=your-secret-key-change-in-production

# Entorno
NODE_ENV=development
